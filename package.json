{
  "name": "bunfirvil",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "낙생지구 포털과 분당퍼스트빌리지 가상 놀이터·자금 계획",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build --config vite.district.config.ts && vite build",
    "preview": "vite preview --config vite.district.config.ts --host 127.0.0.1",
    "preview:commit": "pwsh -NoProfile -File scripts/preview-committed-pages.ps1",
    "local:dev": "pwsh -NoProfile -File scripts/local-operations.ps1 -Mode Dev",
    "local:check": "pwsh -NoProfile -File scripts/local-operations.ps1 -Mode Validate",
    "local:pages": "pwsh -NoProfile -File scripts/local-operations.ps1 -Mode PreviewCommit",
    "sync:assets": "pwsh -NoProfile -File scripts/sync-from-pvp.ps1",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:smoke": "playwright test",
    "test:smoke:ci": "playwright test tests/e2e/ci-smoke.spec.ts tests/e2e/sale-calculator.spec.ts tests/e2e/district-calculator-ux.spec.ts",
    "verify:dist": "node scripts/verify-dist.mjs",
    "validate": "npm run test:unit && npm run build && npm run verify:dist"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.17.2",
    "@types/three": "^0.179.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
